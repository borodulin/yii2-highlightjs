{
    "name": "conquer/highlightjs",
    "description": "highlight.js syntax highlighting widget for Yii2",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "highlightjs",
        "syntax highlighting"
    ],
    "homepage": "https://github.com/borodulin/yii2-highlightjs",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-highlightjs/issues",
        "source": "https://github.com/borodulin/yii2-highlightjs"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "require": {
        "php": "^8.0",
        "yiisoft/yii2": "~2.0.14",
        "npm-asset/highlightjs--cdn-assets": "^11.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "conquer\\highlightjs\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\highlightjs\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
